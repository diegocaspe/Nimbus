# Copia este archivo como .env y cambia los valores. El .env NO se sube a git.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# Administrador del panel (/admin)
NIMBUS_ADMIN_USER=admin
NIMBUS_ADMIN_PASS=cambia-esta-contrasena

# Clave para firmar la cookie de sesión: una cadena larga y aleatoria.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
NIMBUS_SECRET=pon-aqui-una-cadena-aleatoria-larga

# Opcionales (valores por defecto)
NIMBUS_CAPACIDAD=10
NIMBUS_TTL=600
NIMBUS_SIN_CONEXION=0
NIMBUS_LATENCIA_MS=300
